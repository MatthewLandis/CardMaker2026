# Copy to backend/.env for local settings. Everything here is optional during development.

# Port for the API (the Angular dev server forwards /api here)
PORT=4000

# Secret used to sign login tokens. Required when NODE_ENV=production.
# Without it in development, a random one is used and you are logged out when the server restarts.
JWT_SECRET=change-me-to-a-long-random-string

# Where the SQLite database file lives
DB_PATH=data/cardmaker.db
